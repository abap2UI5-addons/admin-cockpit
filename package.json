{
  "name": "abap2ui5-admin-cockpit",
  "private": true,
  "version": "1.0.0",
  "description": "Admin Cockpit for abap2UI5 installations - usage, performance, errors, drafts and a security traffic light, as an abap2UI5 app.",
  "scripts": {
    "lint": "abaplint ./abaplint.jsonc",
    "lint:cloud": "abaplint .github/abaplint/abap_cloud.jsonc",
    "lint:standalone": "abaplint .github/abaplint/abap_standalone.jsonc",
    "lint:702": "abaplint .github/abaplint/abap_702.jsonc",
    "unit": "node .github/scripts/unit.mjs",
    "check:shorttext": "node .github/scripts/shorttext.mjs",
    "check:abap2ui5": "abap2ui5lint",
    "fmt:chains": "abap2ui5lint --fix",
    "syfixes": "find src -type f -name '*.abap' -exec sed -i -e 's/ RAISE EXCEPTION TYPE cx_sy_itab_line_not_found/ ASSERT 1 = 0/g' {} +",
    "downport": "abaplint --fix .github/abaplint/abap_702.jsonc && npm run syfixes",
    "check": "npm run check:shorttext && npm run lint && npm run lint:cloud && npm run lint:standalone && npm run check:abap2ui5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abap2UI5-addons/admin-cockpit.git"
  },
  "keywords": [
    "abap",
    "abap2ui5",
    "monitoring",
    "administration"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/abap2UI5-addons/admin-cockpit/issues"
  },
  "homepage": "https://github.com/abap2UI5-addons/admin-cockpit#readme",
  "devDependencies": {
    "@abap2ui5/linter": "^0.8.5",
    "@abaplint/cli": "^2.120.71"
  },
  "engines": {
    "node": ">=22"
  }
}
