{
  "global": {
    "files": "/../../src/**/*.*",
    // package 01 alone - what the generated standalone branch ships - must
    // activate on the RELEASED abap2UI5, without the monitor hook. The
    // dependency below is pinned to the release tag 1.146.0: main carries the
    // hook since abap2UI5#2837, so linting against main would let a static
    // reference to z2ui5_if_ui5_monitor in src/01 pass. Its own folder keeps a
    // pre-filled main checkout (.abaplint-deps/abap2UI5) from standing in.
    "exclude": ["/src/02/z2ui5_cl_cockpit"]
  },
  "dependencies": [
    {
      "url": "https://github.com/abapedia/steampunk-2305-api-intersect-702",
      "folder": "/../../.abaplint-deps/steampunk",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/abap2UI5/abap2UI5",
      "branch": "1.146.0",
      "folder": "/../../.abaplint-deps/abap2UI5-released",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "Cloud",
    "errorNamespace": "."
  },
  "rules": {
    "downport": true,
    "begin_end_names": true,
    "check_ddic": true,
    "check_include": true,
    "check_syntax": true,
    "global_class": true,
    "definitions_top": false,
    "implement_methods": true,
    "method_implemented_twice": true,
    "parser_error": true,
    "superclass_final": true,
    "unknown_types": true,
    "xml_consistency": true
  }
}
